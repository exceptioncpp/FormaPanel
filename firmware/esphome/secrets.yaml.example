# On the build server copy to firmware/esphome/packages/secrets.yaml.
# Workshop uses an external entry wrapper, so keep secrets beside connection.yaml.
# Keep real credentials out of Git. Generate the API key with Device Builder.
wifi_ssid: "YOUR_2_4_GHZ_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
formapanel_api_key: "YOUR_GENERATED_32_BYTE_BASE64_KEY"
formapanel_ota_password: "YOUR_LONG_RANDOM_OTA_PASSWORD"
